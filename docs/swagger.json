{
    "swagger": "2.0",
    "info": {
        "description": "提供考试密码生成、分发和验证功能的API系统",
        "title": "考试密码分发系统API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/admin/backup": {
            "get": {
                "description": "获取系统初始化时创建的顶级管理员信息",
                "produces": [
                    "application/json"
                ],
                "summary": "获取顶级管理员信息",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.GetAdminBackupResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/admin/deleteAll": {
            "delete": {
                "description": "测试接口：删除所有管理员数据",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "删除所有管理员",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.SuccessResponse"
                        }
                    }
                }
            }
        },
        "/admin/password": {
            "get": {
                "description": "获取指定考试的管理员密码",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "获取管理员密码",
                "parameters": [
                    {
                        "type": "string",
                        "description": "考试ID",
                        "name": "examid",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.GetAdminPasswordResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/admin/update": {
            "post": {
                "description": "更新默认管理员的ID、密码和考试ID",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "更新管理员信息",
                "parameters": [
                    {
                        "description": "更新信息",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controller.UpdateAdminRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.SuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/exam/bind": {
            "post": {
                "description": "用户到达考场后绑定考试并获取密码",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "用户绑定考试",
                "parameters": [
                    {
                        "description": "绑定信息",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controller.BindUserRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.BindUserResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/exam/create": {
            "post": {
                "description": "管理员创建新的考试",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "创建新考试",
                "parameters": [
                    {
                        "description": "考试信息",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controller.CreateExamRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.CreateExamResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/exam/streamtype": {
            "put": {
                "description": "管理员更新指定考试的屏幕流类型",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "更新考试流类型",
                "parameters": [
                    {
                        "description": "更新请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controller.UpdateExamStreamTypeRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.SuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/exam/streamtypes": {
            "get": {
                "description": "获取系统当前支持的屏幕流类型",
                "produces": [
                    "application/json"
                ],
                "summary": "获取支持的流类型",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.StreamTypesResponse"
                        }
                    }
                }
            }
        },
        "/password": {
            "get": {
                "description": "客户端接口：获取一个未分发的考试密码",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "获取考试密码",
                "parameters": [
                    {
                        "type": "string",
                        "description": "用户ID",
                        "name": "userid",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.GetPasswordResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/screen/active": {
            "get": {
                "description": "管理员获取指定考试的所有活跃屏幕流",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "获取活跃的屏幕流",
                "parameters": [
                    {
                        "type": "string",
                        "description": "考试ID",
                        "name": "examid",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/controller.ActiveStreamResponse"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/screen/init": {
            "post": {
                "description": "学生端初始化屏幕流会话",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "初始化屏幕流",
                "parameters": [
                    {
                        "description": "初始化请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controller.InitScreenStreamRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.InitScreenStreamResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/screen/stop": {
            "post": {
                "description": "停止指定的屏幕流会话",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "停止屏幕流",
                "parameters": [
                    {
                        "description": "停止请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controller.StopScreenStreamRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.SuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/user/register": {
            "post": {
                "description": "注册新用户（不关联考试，仅创建基本身份）",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "注册新用户",
                "parameters": [
                    {
                        "description": "注册信息",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controller.RegisterUserRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.RegisterUserResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/user/{userid}": {
            "get": {
                "description": "获取指定ID的用户信息",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "获取用户信息",
                "parameters": [
                    {
                        "type": "string",
                        "description": "用户ID",
                        "name": "userid",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.User"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/validateExamPassword": {
            "post": {
                "description": "验证考试密码是否有效并返回用于后续请求的token",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "考试系统登录",
                "parameters": [
                    {
                        "description": "登录验证信息",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controller.ValidateExamEntryRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.ValidateExamEntryResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/controller.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "controller.ActiveStreamResponse": {
            "type": "object",
            "properties": {
                "examid": {
                    "type": "string",
                    "example": "EXAM001"
                },
                "interval": {
                    "type": "integer",
                    "example": 5
                },
                "sessionid": {
                    "type": "string",
                    "example": "abcdef1234567890"
                },
                "starttime": {
                    "type": "string",
                    "example": "2023-01-01T12:00:00Z"
                },
                "streamtype": {
                    "type": "string",
                    "example": "interval"
                },
                "userid": {
                    "type": "string",
                    "example": "2021001"
                },
                "username": {
                    "type": "string",
                    "example": "张三"
                }
            }
        },
        "controller.BindUserRequest": {
            "type": "object",
            "properties": {
                "examid": {
                    "type": "string",
                    "example": "EXAM001"
                },
                "userid": {
                    "type": "string",
                    "example": "2021001"
                }
            }
        },
        "controller.BindUserResponse": {
            "type": "object",
            "properties": {
                "examid": {
                    "type": "string",
                    "example": "EXAM001"
                },
                "message": {
                    "type": "string",
                    "example": "绑定成功"
                },
                "password": {
                    "type": "string",
                    "example": "a1b2c3d4"
                },
                "userid": {
                    "type": "string",
                    "example": "2021001"
                }
            }
        },
        "controller.CreateExamRequest": {
            "type": "object",
            "properties": {
                "examid": {
                    "description": "考试ID（可选，不提供则自动生成）",
                    "type": "string",
                    "example": "EXAM002"
                },
                "streamtype": {
                    "description": "流类型：interval-定时截屏, realtime-实时直播",
                    "type": "string",
                    "enum": [
                        "interval",
                        "realtime"
                    ],
                    "example": "interval"
                }
            }
        },
        "controller.CreateExamResponse": {
            "type": "object",
            "properties": {
                "examid": {
                    "type": "string",
                    "example": "EXAM002"
                },
                "message": {
                    "type": "string",
                    "example": "考试创建成功"
                },
                "streamtype": {
                    "type": "string",
                    "example": "interval"
                }
            }
        },
        "controller.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "请求参数错误"
                }
            }
        },
        "controller.GetAdminBackupResponse": {
            "type": "object",
            "properties": {
                "adminid": {
                    "type": "string",
                    "example": "admin001"
                },
                "created_at": {
                    "type": "string"
                },
                "examid": {
                    "type": "string",
                    "example": "EXAM001"
                },
                "password": {
                    "type": "string",
                    "example": "admin123456"
                }
            }
        },
        "controller.GetAdminPasswordResponse": {
            "type": "object",
            "properties": {
                "adminid": {
                    "type": "string",
                    "example": "admin001"
                },
                "examid": {
                    "type": "string",
                    "example": "EXAM001"
                },
                "password": {
                    "type": "string",
                    "example": "a1b2c3d4"
                }
            }
        },
        "controller.GetPasswordResponse": {
            "type": "object",
            "properties": {
                "password": {
                    "type": "string",
                    "example": "a1b2c3d4"
                }
            }
        },
        "controller.InitScreenStreamRequest": {
            "type": "object",
            "properties": {
                "interval": {
                    "description": "截屏间隔秒数（仅用于interval类型）",
                    "type": "integer",
                    "example": 5
                },
                "streamtype": {
                    "description": "流类型：interval-定时截屏, realtime-实时直播",
                    "type": "string",
                    "enum": [
                        "interval",
                        "realtime"
                    ],
                    "example": "interval"
                }
            }
        },
        "controller.InitScreenStreamResponse": {
            "type": "object",
            "properties": {
                "examid": {
                    "type": "string",
                    "example": "EXAM001"
                },
                "interval": {
                    "type": "integer",
                    "example": 5
                },
                "message": {
                    "type": "string",
                    "example": "屏幕流会话初始化成功"
                },
                "sessionid": {
                    "type": "string",
                    "example": "abcdef1234567890"
                },
                "streamtype": {
                    "type": "string",
                    "example": "interval"
                },
                "userid": {
                    "type": "string",
                    "example": "2021001"
                }
            }
        },
        "controller.RegisterUserRequest": {
            "type": "object",
            "required": [
                "name",
                "userid"
            ],
            "properties": {
                "name": {
                    "description": "用户姓名",
                    "type": "string",
                    "example": "张三"
                },
                "userid": {
                    "description": "用户ID（学号/工号）",
                    "type": "string",
                    "example": "2021001"
                }
            }
        },
        "controller.RegisterUserResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "注册成功"
                },
                "name": {
                    "type": "string",
                    "example": "张三"
                },
                "userid": {
                    "type": "string",
                    "example": "2021001"
                }
            }
        },
        "controller.StopScreenStreamRequest": {
            "type": "object",
            "required": [
                "sessionid"
            ],
            "properties": {
                "sessionid": {
                    "type": "string",
                    "example": "abcdef1234567890"
                }
            }
        },
        "controller.StreamTypeInfo": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string",
                    "example": "每隔几秒截取一次屏幕，适合低带宽环境"
                },
                "name": {
                    "type": "string",
                    "example": "定时截屏"
                },
                "type": {
                    "type": "string",
                    "example": "interval"
                }
            }
        },
        "controller.StreamTypesResponse": {
            "type": "object",
            "properties": {
                "streamtypes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/controller.StreamTypeInfo"
                    }
                }
            }
        },
        "controller.SuccessResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "操作成功"
                }
            }
        },
        "controller.UpdateAdminRequest": {
            "type": "object",
            "required": [
                "new_adminid",
                "new_examid",
                "new_password",
                "old_adminid",
                "old_examid",
                "old_password"
            ],
            "properties": {
                "new_adminid": {
                    "type": "string",
                    "example": "customAdmin"
                },
                "new_examid": {
                    "type": "string",
                    "example": "CUSTOM001"
                },
                "new_password": {
                    "type": "string",
                    "example": "customPassword"
                },
                "old_adminid": {
                    "type": "string",
                    "example": "admin"
                },
                "old_examid": {
                    "type": "string",
                    "example": "EXAM001"
                },
                "old_password": {
                    "type": "string",
                    "example": "admin123"
                }
            }
        },
        "controller.UpdateExamStreamTypeRequest": {
            "type": "object",
            "required": [
                "examid",
                "streamtype"
            ],
            "properties": {
                "examid": {
                    "type": "string",
                    "example": "EXAM001"
                },
                "streamtype": {
                    "type": "string",
                    "enum": [
                        "interval",
                        "realtime"
                    ],
                    "example": "realtime"
                }
            }
        },
        "controller.User": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "example": "张三"
                },
                "userid": {
                    "type": "string",
                    "example": "2021001"
                }
            }
        },
        "controller.ValidateExamEntryRequest": {
            "type": "object",
            "properties": {
                "examid": {
                    "type": "string",
                    "example": "EXAM001"
                },
                "password": {
                    "type": "string",
                    "example": "a1b2c3d4"
                },
                "userid": {
                    "type": "string",
                    "example": "2021001"
                }
            }
        },
        "controller.ValidateExamEntryResponse": {
            "type": "object",
            "properties": {
                "examid": {
                    "type": "string",
                    "example": "EXAM001"
                },
                "is_default": {
                    "type": "boolean",
                    "example": false
                },
                "message": {
                    "type": "string",
                    "example": "验证成功"
                },
                "role": {
                    "type": "string",
                    "enum": [
                        "student",
                        "admin"
                    ],
                    "example": "student"
                },
                "token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIs..."
                },
                "userid": {
                    "type": "string",
                    "example": "2021001"
                }
            }
        }
    }
}